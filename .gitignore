# ══════════════════════════════════════════════════════════
# UTHelper — .gitignore
# ══════════════════════════════════════════════════════════

# ── Secrets & credentials ──
.env
.env.*
*.key
*.pem
credentials.json
notifications_cache.json
settings.json
keystore.jks
*.keystore
upload-keystore.jks

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.pytype/

# ── Virtual environments ──
.venv/
venv/
ENV/

# ── Dependencies ──
node_modules/
vendor/

# ── OS files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ── Logs ──
*.log
npm-debug.log*

# ── Build output ──
tmp/
dist/
build/
*.spec

# ── Flet build artifacts ──
# Android
build/apk/
build/aab/
*.apk
*.aab

# iOS
build/ipa/
*.ipa
ios/

# Windows
build/windows/

# Web
build/web/

# Flet internal
.flet/
flet_build/

# ── Flutter / Dart (generated by flet build) ──
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages

# ── Android SDK/Gradle ──
.gradle/
local.properties
*.hprof

# ── Project-specific ──
parsepage/
benchmark_*.py

# ── Agent workspace (skill configs, not source) ──
.agent/

# ── Installer output ──
Output/
*.exe
!scripts/*.exe

# ── Coverage & reports ──
coverage/
.nyc_output/
test-results/